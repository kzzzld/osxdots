layout {
  default_tab_template {
    pane size=1 borderless=true {
      plugin location="tab-bar"
    }
    children
    pane size=1 borderless=true {
      plugin location="status-bar"
    }
  }

  tab name="Codex" {
    pane command="codex"
  }

  tab name="Server" {
    pane command="npm" {
      args "run" "dev"
    }
  }

  tab name="Shell" {
    pane
  }
}
